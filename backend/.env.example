# =============================================================================
# Product Recommendation Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Environment: development, staging, production
ENVIRONMENT=development

# API Settings
API_TITLE="Product Recommendation API"
API_VERSION="1.0.0"
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=product_recommendation

# Full database URL (auto-constructed from above, or override manually)
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password@localhost:5432/product_recommendation

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# -----------------------------------------------------------------------------
# Qdrant Vector Database (HACKATHON CORE)
# -----------------------------------------------------------------------------
# Qdrant connection
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=  # Optional, leave empty for local development
QDRANT_HTTPS=false

# Qdrant collection name
QDRANT_COLLECTION_NAME=products

# Vector dimensions
TEXT_VECTOR_DIM=384  # sentence-transformers/all-MiniLM-L6-v2
IMAGE_VECTOR_DIM=512  # Vertex AI multimodal embeddings (adjust as needed)

# Quantization settings (INT8 scalar quantization for hackathon demo)
QDRANT_QUANTIZATION_ENABLED=true

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# JWT Secret Key (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_hex_32

# JWT Algorithm
ALGORITHM=HS256

# Access token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8100

# -----------------------------------------------------------------------------
# AI/ML Services
# -----------------------------------------------------------------------------
# Google Cloud / Vertex AI (Primary Embeddings)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
VERTEX_AI_LOCATION=us-central1  # or your preferred region

# Vertex AI model names
VERTEX_TEXT_MODEL=textembedding-gecko@003
VERTEX_MULTIMODAL_MODEL=multimodalembedding@001

# Gemini API (for recommendation explanations)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro

# Fallback: Sentence Transformers (local)
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
SENTENCE_TRANSFORMER_DEVICE=cpu  # or cuda if GPU available

# -----------------------------------------------------------------------------
# Chunking Settings
# -----------------------------------------------------------------------------
# Chunking strategy: chonkie or langchain
CHUNKING_STRATEGY=chonkie

# Chunk size and overlap
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# -----------------------------------------------------------------------------
# Recommendation Settings
# -----------------------------------------------------------------------------
# Default recommendation limit
DEFAULT_RECOMMENDATION_LIMIT=10

# ANN search parameters
QDRANT_SEARCH_LIMIT=50  # Oversampling for rescoring
QDRANT_SCORE_THRESHOLD=0.5

# Re-ranking weights
RERANK_WEIGHT_EMBEDDING=0.6
RERANK_WEIGHT_BEHAVIOR=0.3
RERANK_WEIGHT_BUDGET=0.1

# -----------------------------------------------------------------------------
# Scraping Settings (for browser extension)
# -----------------------------------------------------------------------------
# Supported sources
SUPPORTED_SOURCES=amazon,ebay,jumia,aliexpress

# Rate limiting
SCRAPE_RATE_LIMIT_PER_MINUTE=30

# User-Agent for scraping
SCRAPE_USER_AGENT="Mozilla/5.0 (compatible; RecommendationBot/1.0)"

# -----------------------------------------------------------------------------
# Currency & Localization
# -----------------------------------------------------------------------------
DEFAULT_CURRENCY=TND
SUPPORTED_CURRENCIES=TND,USD,EUR

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json or text

# -----------------------------------------------------------------------------
# Redis (Optional - for caching/rate limiting)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------
TEST_DATABASE_URL=postgresql+asyncpg://postgres:test_password@localhost:5432/test_product_recommendation